# Скопируйте в .env и поправьте под себя. Файл .env в git не попадает.

# Порт HTTP-сервера (по умолчанию 8080).
PORT=8080

# Подключение к PostgreSQL в форме postgres://user:password@host:port/db.
DATABASE_URL=postgres://postgres:password@localhost:5432/appdb

# Отдельная база для своих тестов API (необязательно; без неё тесты берут DATABASE_URL).
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/appdb_test

# Каталог со статикой фронтенда (по умолчанию public, его раскладывает make build).
STATIC_DIR=public

# DSN сборщика ошибок (Sentry/Bugsink). Пусто — мониторинг выключен.
MONITORING_DSN=

# Учётные данные базы для compose.yaml.
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
